{
  "name": "agentplaybooks",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "author": "AgentPlaybooks",
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/generate-blog-slugs.ts",
    "build": "next build",
    "postbuild:worker": "tsx scripts/copy-markdown-assets.ts",
    "start": "next start",
    "lint": "eslint",
    "sync-sitemap": "tsx scripts/sync-sitemap-docs.ts",
    "build:worker": "npm run prebuild && opennextjs-cloudflare build && npm run postbuild:worker",
    "dev:worker": "opennextjs-cloudflare dev",
    "preview": "opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv",
    "seed": "tsx scripts/seed-data.ts",
    "seed:skills": "tsx scripts/github-skill-parser.ts",
    "seed:dry": "DRY_RUN=true tsx scripts/seed-data.ts",
    "test": "vitest",
    "test:cli": "npm --prefix packages/cli test",
    "test:all": "vitest run && npm run test:cli",
    "release:check": "node scripts/check-release-distribution.mjs",
    "test:watch": "vitest",
    "audit:production": "node scripts/audit-production.mjs",
    "smoke": "node scripts/smoke-mcp.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@supabase/supabase-js": "^2.116.0",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.0",
    "hono": "^4.13.7",
    "jszip": "^3.10.2",
    "lucide-react": "^1.44.0",
    "next": "16.3.5",
    "next-intl": "^4.14.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260920.1",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "^9.39.2",
    "@swc/helpers": "^0.5.23",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "4.135.0"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "undici": "7.29.0",
    "postcss": "8.5.28",
    "sharp": "0.35.4",
    "@opennextjs/cloudflare": {
      "glob": {
        "minimatch": {
          "brace-expansion": "5.0.9"
        }
      },
      "@opennextjs/aws": {
        "@node-minify/core": {
          "glob": {
            "minimatch": {
              "brace-expansion": "2.1.4"
            }
          }
        }
      }
    },
    "js-yaml": "4.3.2",
    "@typescript-eslint/typescript-estree": {
      "brace-expansion": "5.0.9"
    }
  }
}
