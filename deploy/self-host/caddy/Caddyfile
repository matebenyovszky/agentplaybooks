# Caddy emits a SHA-256 hex fingerprint natively. Overwrite identity headers
# so a client cannot supply its own. Optional client auth keeps API keys and
# the dashboard working on the same host; use "require_and_verify" on a
# dedicated runtime hostname.

{
	admin off
}

{$CADDY_SITE:localhost} {
	tls /certs/server.crt /certs/server.key {
		client_auth {
			mode verify_if_given
			trust_pool file /certs/ca.crt
		}
	}

	reverse_proxy app:3000 {
		header_up -X-SSL-Client-Fingerprint
		header_up -X-SSL-Client-Verify
		header_up X-SSL-Client-Fingerprint {http.request.tls.client.fingerprint}
		header_up X-SSL-Client-Verify SUCCESS
		header_up X-APB-Proxy-Token {$MTLS_PROXY_SHARED_SECRET}
		header_up X-APB-Proxy-Address 172.28.0.10
		header_up X-Forwarded-Proto {scheme}
	}
}
