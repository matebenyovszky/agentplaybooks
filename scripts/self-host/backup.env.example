# Copy to a file that is NOT committed (e.g. /etc/agentplaybooks/backup.env)
# and `set -a; . /etc/agentplaybooks/backup.env; set +a` before backup/restore.
#
# The vault master key MUST NOT live in the backup archive. Keep it in a
# password manager, HSM, or sealed envelope stored offsite, separate from
# BACKUP_ENCRYPTION_PASSPHRASE.

# Postgres (when using scripts/self-host/compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres
POSTGRES_PORT=54322

# App vault master key — 64 hex chars. Restore is useless without this.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETS_ENCRYPTION_KEY=

# Passphrase that encrypts the backup archive. Different from the vault key.
BACKUP_ENCRYPTION_PASSPHRASE=

# Where archives are written
BACKUP_DIR=./backups

# Retention: delete archives older than N days; also keep at most M newest
BACKUP_RETENTION_DAYS=90
BACKUP_KEEP_COUNT=14

# Optional offsite copy (rsync destination). Example: backup@offsite:/var/backups/apb/
BACKUP_OFFSITE_RSYNC=

# Optional: point at an official self-hosted Supabase compose project instead
# of scripts/self-host/compose.yml
# COMPOSE_FILE=/opt/supabase/docker/docker-compose.yml
# COMPOSE_PROJECT_NAME=supabase
# DB_SERVICE=db
# STORAGE_SERVICE=storage
# STORAGE_PATH=/var/lib/storage
